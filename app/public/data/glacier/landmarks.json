ata":"Q7372358","url":null},{"id":"way/82709616","name":"Avalanche Lake","kind":"lake","lon":-113.78667,"lat":48.65618,"ele_m":1190.2,"wikidata":"Q4827485","url":null},{"id":"way/82676753","name":"Bench Lake","kind":"lake","lon":-113.93771,"lat":48.88249,"ele_m":2066.5,"wikidata":"Q7372127","url":null},{"id":"way/82867884","name":"Bowman Lake","kind":"lake","lon":-114.15843,"lat":48.8671,"ele_m":1228.3,"wikidata":"Q2555689","url":null},{"id":"way/83447402","name":"Cobalt Lake","kind":"lake","lon":-113.42606,"lat":48.43459,"ele_m":2002.5,"wikidata":"Q5138715","url":null},{"id":"way/82676855","name":"Cosley Lake","kind":"lake","lon":-113.75893,"lat":48.92202,"ele_m":1475.8,"wikidata":"Q5173961","url":null},{"id":"way/83326040","name":"Heavens Peak Lookout","kind":"viewpoint","lon":-113.87631,"lat":48.74884,"ele_m":null,"wikidata":"Q5694522","url":null},{"id":"way/83326235","name":"Saint Mary Visitor Center","kind":"visitor centre","lon":-113.43906,"lat":48.74731,"ele_m":null,"wikidata":"Q7401865","url":"https://en.wikipedia.org/wiki/Saint_Mary_Visitor_Center,_Entrance_Station_and_Checking_Stations","tour":7,"summary":{"extract":"The Saint Mary Visitor Center in Glacier National Park, with the connected Saint Mary Checking Station and Entrance Station was constructed at the east entrance to the Going-to-the-Sun Road during the Mission 66 park facilities improvement program. It was designed by Burt L. Gewalt of the Kalispell, Montana architectural firm Brinkman and Lenon, and was completed in 1967. The complex uses common Mission 66 themes such as native stone, and glulam timber construction, combined with a dramatic roof structure that echoes the mountain peaks in the background. The stone in the walls came from the Going-to-the-Sun Road. The view of the \"St. Mary\" webcam on the Glacier National Park official website is broadcast from the center and shows the westward-facing view over St. Mary Lake, which includes a distant view of Logan's Pass. There is also an ospr