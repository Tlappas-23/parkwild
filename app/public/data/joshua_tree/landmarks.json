/by/1.0","artist":"డా. గన్నవరపు నరసింహమూర్తి"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a5/Chipmunk_%2833617656710%29.jpg/960px-Chipmunk_%2833617656710%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Chipmunk_(33617656710).jpg","dist_m":89,"width":640,"height":360,"license":"CC BY 2.0","license_url":"https://creativecommons.org/licenses/by/2.0","artist":"Ed Dunens"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/5/50/Chipmunk_%2833845584482%29.jpg/960px-Chipmunk_%2833845584482%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Chipmunk_(33845584482).jpg","dist_m":89,"width":640,"height":427,"license":"CC BY 2.0","license_url":"https://creativecommons.org/licenses/by/2.0","artist":"Ed Dunens"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/0/05/Hidden_Valley_%28Joshua_Tree_National_Park%29_%2852615966728%29.jpg/960px-Hidden_Valley_%28Joshua_Tree_National_Park%29_%2852615966728%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Hidden_Valley_(Joshua_Tree_National_Park)_(52615966728).jpg","dist_m":120,"width":640,"height":960,"license":"CC BY-SA 2.0","license_url":"https://creativecommons.org/licenses/by-sa/2.0","artist":"Domenico Convertini from Zurich, Schweiz"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f6/Hidden_Valley_%28Joshua_Tree_National_Park%29_%2852615910800%29.jpg/960px-Hidden_Valley_%28Joshua_Tree_National_Park%29_%2852615910800%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Hidden_Valley_(Joshua_Tree_National_Park)_(52615910800).jpg","dist_m":120,"width":640,"height":427,"license":"CC BY-SA 2.0","license_url":"https://creativecommons.org/licenses/by-sa/2.0","artist":"Domenico Convertini from Zurich, Schweiz"}],"street":{"image_id":"532114034472164","username":"muthu","captured_at":"2019-07-15","is_pano":false,"dist_m":25,"url":"https://www.mapillary.com/app/?pKey=532114034472164","license":"CC BY-SA 4.0"}},{"id":"way/47957606","name":"Cottonwood Visitor Center","kind":"visitor centre","lon":-115.82396,"lat":33.7486,"ele_m":null,"wikidata":"Q36742190","url":null},{"id":"node/2822144488","name":"Keys Desert Queen Ranch","kind":"attraction","lon":-116.16947,"lat":34.04619,"ele_m":null,"wikidata":"Q14682963","url":"https://en.wikipedia.org/wiki/Keys_Desert_Queen_Ranch","tour":2,"summary":{"extract":"The Keys Ranch is the prime example of early settlement in the Joshua Tree National Park area. Bill Keys was the area's leading character, and his ranch is a symbol of the resourcefulness of early settlers. The ranch is an extensive complex of small frame buildings built between 1910 and Keys' death in 1969. Keys pursued both ranching and mining to make a living in the desert.","url":"https://en.wikipedia.org/wiki/Keys_Desert_Queen_Ranch","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5b/Desert_Queen_Ranch_-_Fordson_2.jpg/960px-Desert_Queen_Ranch_-_Fordson_2.jpg","page":"https://commons.wikimedia.org/wiki/File:Desert_Queen_Ranch_-_Fordson_2.jpg","dist_m":12,"width":640,"height":383,"license":"CC BY 3.0","license_url":"https://creativecommons.org/licenses/by/3.0","artist":"Jarek Tuszyński"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bf/Desert_Queen_Ranch_-_Fordson_2-crop.jpg/960px-Desert_Queen_Ranch_-_Fordson_2-crop.jpg","page":"https://commons.wikimedia.org/wiki/File:Desert_Queen_Ranch_-_Fordson_2-crop.jpg","dist_m":12,"width":640,"height":320,"license":"CC BY 3.0","license_url":"https://creativecommons.org/licenses/by/3.0","artist":"Jarek Tuszyński"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/9/92/Desert_Queen_Ranch_-_Fordson_1.jpg/960px-Desert_Queen_Ranch_-_Fordson_1.jpg","page":"https://commons.wikimedia.org/wiki/File:Desert_Queen_Ranch_-_Fordson_1.jpg","dist_m":16,"width":640,"height":440,"license":"CC BY 3.0","license_url":"https://creativecommons.org/licenses/by/3.0","artist":"Jarek Tuszyński"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4e/Desert_Queen_Ranch_-_Willy%27s_Jeep.jpg/960px-Desert_Queen_Ranch_-_Willy%27s_Jeep.jpg","page":"https://commons.wikimedia.org/wiki/File:Desert_Queen_Ranch_-_Willy%27s_Jeep.jpg","dist_m":32,"width":640,"height":428,"license":"CC BY 3.0","license_url":"https://creativecommons.org/licenses/by/3.0","artist":"Jarek Tuszyński"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/Keys_Ranch_Historic_Vehicle_and_Main_House_%2850997128745%29.jpg/960px-Keys_Ranch_Historic_Vehicle_and_Main_House_%2850997128745%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Keys_Ranch_Historic_Vehicle_and_Main_House_(50997128745).jpg","dist_m":42,"width":640,"height":386,"license":"Public domain","license_url":"","artist":"Joshua Tree National Park"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/5/54/Mack_Truck%2C_Keys_Ranch_%286566459663%29.jpg/960px-Mack_Truck%2C_Keys_Ranch_%286566459663%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Mack_Truck,_Keys_Ranch_(6566459663).jpg","dist_m":45,"width":640,"height":440,"license":"CC BY-SA 2.0","license_url":"https://creativecommons.org/licenses/by-sa/2.0","artist":"Joseph from Cabin On The Road, USA"}],"street":null},{"id":"node/369164310","name":"Elton Mine","kind":"attraction","lon":-116.06528,"lat":34.01112,"ele_m":1375.0,"wikidata":"Q49410214","url":null},{"id":"way/96595533","name":"Barker Dam","kind":"historic","lon":-116.14633,"lat":34.03089,"ele_m":null,"wikidata":"Q4860949","url":"https://en.wikipedia.org/wiki/Barker_Dam_(California)","tour":3,"summary":{"extract":"Barker Dam, also known as Big Horn Dam, is a dam with water-storage reservoir located in Joshua Tree National Park in California. The dam was constructed by early cattlemen, including C. O. Barker, in 1900. It was raised in 1949 by rancher William F. Keys. It is situated between Queen Valley and the Wonderland of Rocks near the Wall Street Mill. It is a gathering place for desert wildlife, including many species of birds and desert bighorn sheep. Visitors can reach the dam via a short loop trail from a nearby parking lot off Barker Dam Road, and can see Native American petroglyphs a short distance to the west. There is also good bouldering on side trails near the dam. The park offers a Barker Dam Nature Hike led by a ranger.","url":"https://en.wikipedia.org/wiki/Barker_Dam_(California)","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Barker_Dam_-_panoramio_%281%29.jpg/960px-Barker_Dam_-_panoramio_%281%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Barker_Dam_-_panoramio_(1).jpg","dist_m":6,"width":640,"height":480,"license":"CC BY-SA 3.0","license_url":"https://creativecommons.org/licenses/by-sa/3.0","artist":"ogwen"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Crotaphytus_bicinctores_56146995.jpg/960px-Crotaphytus_bicinctores_56146995.jpg","page":"https://commons.wikimedia.org/wiki/File:Crotaphytus_bicinctores_56146995.jpg","dist_m":8,"width":640,"height":307,"license":"CC BY 4.0","license_url":"https://creativecommons.org/licenses/by/4.0","artist":"John Powers"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a2/Barker_Dam_-_panoramio.jpg/960px-Barker_Dam_-_panoramio.jpg","page":"https://commons.wikimedia.org/wiki/File:Barker_Dam_-_panoramio.jpg","dist_m":13,"width":640,"height":360,"license":"CC BY 3.0","license_url":"https://creativecommons.org/licenses/by/3.0","artist":"David Balmer"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/Barker_Dam_Joshua_Tree_December_2013_005.jpg/960px-Barker_Dam_Joshua_Tree_December_2013_005.jpg","page":"https://commons.wikimedia.org/wiki/File:Barker_Dam_Joshua_Tree_December_2013_005.jpg","dist_m":15,"width":640,"height":320,"license":"CC BY-SA 3.0","license_url":"https://creativecommons.org/licenses/by-sa/3.0","artist":"King of Hearts"},{"url":"https://upload.wikimedia.