dia/commons/thumb/9/98/Juncus_parryi_-_29245894707.jpg/960px-Juncus_parryi_-_29245894707.jpg","page":"https://commons.wikimedia.org/wiki/File:Juncus_parryi_-_29245894707.jpg","dist_m":59,"width":640,"height":480,"license":"CC BY-SA 2.0","license_url":"https://creativecommons.org/licenses/by-sa/2.0","artist":"Matt Lavin"},{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a7/Donohue_Pass_summit.jpg","page":"https://commons.wikimedia.org/wiki/File:Donohue_Pass_summit.jpg","dist_m":165,"width":640,"height":426,"license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","artist":"HikingMike1"}],"street":{"image_id":"1028014485660506","username":"michaelakovacich","captured_at":"2024-07-31","is_pano":true,"dist_m":102,"url":"https://www.mapillary.com/app/?pKey=1028014485660506","license":"CC BY-SA 4.0"}},{"id":"node/331507160","name":"Glacier Point","kind":"viewpoint","lon":-119.57367,"lat":37.73067,"ele_m":2198.0,"wikidata":"Q3108318","url":"https://en.wikipedia.org/wiki/Glacier_Point","tour":3,"summary":{"extract":"Glacier Point is a viewpoint above Yosemite Valley in the U.S. state of California. It is located on the south wall of Yosemite Valley at an elevation of 7,214 feet (2,199 m), 3,200 feet (980 m) above Curry Village. The point offers a superb view of several of Yosemite National Park's well-known landmarks, including Yosemite Valley, Yosemite Falls, Half Dome, Vernal Fall, Nevada Fall, and Clouds Rest. Between 1872 and 1968, it was the site of the Yosemite Firefall.","url":"https://en.wikipedia.org/wiki/Glacier_Point","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Panorama-Half_Dome.JPG/960px-Panorama-Half_Dome.JPG","page":"https://commons.wikimedia.org/wiki/File:Panorama-Half_Dome.JPG","dist_m":3,"width":640,"height":145,"license":"CC BY-SA 3.0","license_url":"https://creativecommons.org/licenses/by-sa/3.0","artist":"Timwilgibson"},{"url":"https