.wikimedia.org/wiki/File:Sandstone_-_Flickr_-_brewbooks.jpg","dist_m":269,"width":640,"height":427,"license":"CC BY-SA 2.0","license_url":"https://creativecommons.org/licenses/by-sa/2.0","artist":"brewbooks from near Seattle, USA"}],"street":null},{"id":"way/174994338","name":"Hermit’s Rest","kind":"historic","lon":-112.21111,"lat":36.06203,"ele_m":2029.0,"wikidata":"Q2623583","url":"https://en.wikipedia.org/wiki/Hermits_Rest","tour":0,"summary":{"extract":"Hermits Rest is a structure built in 1914 at the western end of Hermit Road at the south rim of the Grand Canyon in Arizona, United States. The Hermit Trail, a hiking trail that extends to the Colorado River, begins about ¼ mile beyond the shuttle bus stop at Hermits Rest. Hermits Rest also represents the western terminus of the Rim Trail. The location was named for Louis Boucher. Around 1891, Boucher – a Canadian-born prospector – staked claims below present-day Hermits Rest. With help, Boucher carved the aforementioned trail into the canyon, and for years lived alone at nearby Dripping Springs. The main structure currently standing at Hermits Rest was designed by architect Mary Colter. Hermits Rest is the westernmost point on the canyon's south rim that is accessible by paved road. It was built as a rest area for tourists on coaches operated by the Fred Harvey Company on the way to the now-vanished Hermit Camp. The building was designed to appear to be a natural stone formation, closely tied to the land. Colter selected furnishings that are included in the National Historic Landmark designation.","url":"https://en.wikipedia.org/wiki/Hermits_Rest","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/e/eb/Grand_Canyon_Nat_Park_Widforss_Postcard_H4486_%286817802171%29.jpg/960px-Grand_Canyon_Nat_Park_Widforss_Postcard_H4486_%286817802171%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Grand_Canyon_Nat_Park_Widforss_Postcard_H4486_(6817802171).jpg","dist_m":21,"width":640,"height":401,"license":"CC BY 2.0","license_url":"https://creativecommons.org/licenses/by/2.0","artist":"Grand Canyon National Park"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/d/df/Ra%2C_Osiris%2C_Horus%2C_Set_-_Grand_Canyon_South_Rim.jpg/960px-Ra%2C_Osiris%2C_Horus%2C_Set_-_Grand_Canyon_South_Rim.jpg","page":"https://commons.wikimedia.org/wiki/File:Ra,_Osiris,_Horus,_Set_-_Grand_Canyon_South_Rim.jpg","dist_m":22,"width":640,"height":315,"license":"CC BY-SA 2.0","license_url":"https://creativecommons.org/licenses/by-sa/2.0","artist":"Laurent Goujon"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2f/Hermits_Rest%2C_Grand_Canyon_%286633031015%29.jpg/960px-Hermits_Rest%2C_Grand_Canyon_%286633031015%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Hermits_Rest,_Grand_Canyon_(6633031015).jpg","dist_m":35,"width":640,"height":425,"license":"CC BY-SA 2.0","license_url":"https://creativecommons.org/licenses/by-sa/2.0","artist":"InSapphoWeTrust from Los Angeles, California, USA"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/14/Treated_Canyon_-_panoramio.jpg/960px-Treated_Canyon_-_panoramio.jpg","page":"https://commons.wikimedia.org/wiki/File:Treated_Canyon_-_panoramio.jpg","dist_m":49,"width":640,"height":360,"license":"CC BY 3.0","license_url":"https://creativecommons.org/licenses/by/3.0","artist":"bahniuk"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5d/Grand_Canyon_National_Park_Hermits_Rest_20100612_5852_%284701862912%29.jpg/960px-Grand_Canyon_National_Park_Hermits_Rest_20100612_5852_%284701862912%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Grand_Canyon_National_Park_Hermits_Rest_20100612_5852_(4701862912).jpg","dist_m":52,"width":640,"height":480,"license":"CC BY 2.0","license_url":"https://creativecommons.org/licenses/by/2.0","artist":"Grand Canyon National Park"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/49/Grand_Canyon_National_Park_Hermits_Rest_Fireplace_Interior_22_%285952621773%29.jpg/960px-Grand_Canyon_National_Park_Hermits_Rest_Fireplace_Interior_22_%285952621773%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Grand_Canyon_National_Park_Hermits_Rest_Fireplace_Interior_22_(5952621773).jpg","dist_m":59,"width":640,"height":509,"license":"CC BY 2.0","license_url":"https://creativecommons.org/licenses/by/2.0","artist":"Grand Canyon National Park"}],"street":{"image_id":"462932331488966","username":"zuse","captured_at":"2011-07-12","is_pano":false,"dist_m":44,"url":"https://www.mapillary.com/app/?pKey=462932331488966","license":"CC BY-SA 4.0"}},{"id":"node/5907460257","name":"TWA Flight 2 Lockheed L-1049 (N6902C)","kind":"historic","lon":-111.81732,"lat":36.17854,"ele_m":null,"wikidata":"Q1116495","url":"https://en.wikipedia.org/wiki/1956_Grand_Canyon_mid-air_collision","tour":6,"summary":{"extract":"On June 30, 1956, a Lockheed L-1049A Super Constellation operating as TWA Flight 2, was struck by a Douglas DC-7 Mainliner operating as United Air Lines Flight 718 over Grand Canyon National Park, Arizona. The Constellation fell into the canyon, while the DC-7 slammed into a cliff. All 128 people on board both aircraft died, making it the first commercial airline incident to exceed one hundred fatalities. Both aircraft had departed Los Angeles International Airport minutes apart from each other and headed for Chicago and Kansas City, respectively.\nThe collision took place in uncontrolled airspace, where it was the pilots' responsibility to maintain separation. This highlighted the antiquated state of air traffic control, which became the focus of major aviation reforms.","url":"https://en.wikipedia.org/wiki/1956_Grand_Canyon_mid-air_collision","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[],"street":null},{"id":"node/5907460258","name":"United Air Lines Flight 718 Douglas DC-7 (N6324C)","kind":"historic","lon":-111.80736,"lat":36.19436,"ele_m":null,"wikidata":"Q1116495","url":"https://en.wikipedia.org/wiki/1956_Grand_Canyon_mid-air_collision","tour":7,"summary":{"extract":"On June 30, 1956, a Lockheed L-1049A Super Constellation operating as TWA Flight 2, was struck by a Douglas DC-7 Mainliner operating as United Air Lines Flight 718 over Grand Canyon National Park, Arizona. The Constellation fell into the canyon, while the DC-7 slammed into a cliff. All 128 people on board both aircraft died, making it the first commercial airline incident to exceed one hundred fatalities. Both aircraft had departed Los Angeles International Airport minutes apart from each other and headed for Chicago and Kansas City, respectively.\nThe collision took place in uncontrolled airspace, where it was the pilots' responsibility to maintain separation. This highlighted the antiquated state of air traffic control, which became the focus of major aviation reforms.","url":"https://en.wikipedia.org/wiki/1956_Grand_Canyon_mid-air_collision","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8d/Confluence_convergence_of_the_Colorado_and_Little_Colorado_Rivers_in_the_Grand_Canyon._The_muddy_Little_Colorado_joins_the_main_channel_and_soon_mixes_into_the_river._%2852983276347%29.jpg/960px-thumbnail.jpg","page":"https://commons.wikimedia.org/wiki/File:Confluence_convergence_of_the_Colorado_and_Little_Colorado_Rivers_in_the_Grand_Canyon._The_muddy_Little_Colorado_joins_the_main_channel_and_soon_mixes_into_the_river._(52983276347).jpg","dist_m":312,"width":640,"height":480,"license":"CC BY 2.0","license_url":"https://creativecommons.org/licenses/by/2.0","artist":"Nate Loper from Flagstaff, AZ, USA"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/25/Grand_Canyon_DEIS_Aerial_Confluence_of_Colorado_%26_Little_Colorado_Rivers_%285477434484%29.jpg/960px-Grand_Canyon_DEIS_Aerial_Confluence_of_Colorado_%26_Little_Colorado_Rivers_%285477434484%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Grand_Canyon_DEIS_Aerial_Confluence_of_Colorado_%26_Little_Colorado_Rivers_(5477434484).jpg","dist_m":320,"width":640,"height":425,"license":"CC BY 2.0","license_url":"https://creativecommons.org/licenses/by/2.0","artist":"Grand Canyon National Park"}],"street":null},{"id":"node/369090577","name":"Last Chance Mine","kind":"historic","lon":-111.97461,"lat":36.01748,"ele_m":1413.0,"wikidata":"Q49425069","url":null},{"id":"way/172583850","name":"Old Navajo Bridge","kind":"historic","lon":-111.63157,"lat":36.8178,"ele_m":null,"wikidata":"Q6981625","url":null},{"id":"node/835142954","name":"Tusayan Ruin and Museum","kind":"historic","lon":-111.86579,"lat":36.0134,"ele_m":null,"wikidata":"Q4466574","url":null},{"id":"node/150952317","name":"Grand Canyon Village","kind":"place","lon":-112.14063,"lat":36.05452,"ele_m":null,"wikidata":"Q182273","url":"https://en.wikipedia.org/wiki/Grand_Canyon_Village,_Arizona","tour":2,"summary":{"extract":"Grand Canyon Village is a census-designated place (CDP) located on the South Rim of the Grand Canyon, in Coconino County, Arizona, United States. Its population was 2,004 at the 2010 Census. Located in Grand Canyon National Park, it is wholly focused on accommodating tourists visiting the canyon. Its origins trace back to the railroad completed from Williams, to the canyon's South Rim by the Santa Fe Railroad in 1901. Many of the structures in use today date from that period. The village contains numerous landmark buildings, and its historic core is a National Historic Landmark District, designated for its outstanding implementation of town design. The Grand Canyon Village Historic District includes numerous landmark park structures, many of which are National Historic Landmarks themselves, or are listed on the National Register of Historic Places. The town design as a whole is also significant for its attention to integration with the Grand Canyon landscape, its incorporation of National Park Service Rustic design elements, and for the idiosyncratic design of park concessioner structures such as the El Tovar Hotel.","url":"https://en.wikipedia.org/wiki/Grand_Canyon_Village%2C_Arizona","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/23/Pyrgus_xanthus_59685134.jpg/960px-Pyrgus_xanthus_59685134.jpg","page":"https://commons.wikimedia.org/wiki/File:Pyrgus_xanthus_59685134.jpg","dist_m":47,"width":640,"height":480,"license":"CC0","license_url":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","artist":"Robb Hannawacker"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/Papilio_machaon_bairdii_59595045.jpg/960px-Papilio_machaon_bairdii_59595045.jpg","page":"https://commons.wikimedia.org/wiki/File:Papilio_machaon_bairdii_59595045.jpg","dist_m":47,"width":640,"height":480,"license":"CC0","license_url":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","artist":"Robb Hannawacker"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/Colorful_Grand_Canyon_%28Unsplash%29.jpg/960px-Colorful_Grand_Canyon_%28Unsplash%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Colorful_Grand_Canyon_(Unsplash).jpg","dist_m":47,"width":640,"height":427,"license":"CC0","license_url":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","artist":"Quinn Nietfeld quinton_nietfeld"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/8/84/Rainbow_over_the_Grand_Canyon_%28Unsplash%29.jpg/960px-Rainbow_over_the_Grand_Canyon_%28Unsplash%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Rainbow_over_the_Grand_Canyon_(Unsplash).jpg","dist_m":47,"width":640,"height":427,"license":"CC0","license_url":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","artist":"Tim Trad timtrad"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/17/Pyrgus_xanthus_59683759.jpg/960px-Pyrgus_xanthus_59683759.jpg","page":"https://commons.wikimedia.org/wiki/File:Pyrgus_