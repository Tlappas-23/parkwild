":41.68395,"ele_m":null,"wikidata":"Q14688432","url":"https://en.wikipedia.org/wiki/House_of_Tomorrow_(Indiana)"},{"id":"way/431490555","name":"Joseph Bailly Homestead","kind":"historic","lon":-87.0942,"lat":41.62329,"ele_m":null,"wikidata":"Q6281283","url":"https://en.wikipedia.org/wiki/Joseph_Bailly_Homestead"},{"id":"way/438728816","name":"Joseph Bailly House","kind":"historic","lon":-87.09412,"lat":41.62307,"ele_m":null,"wikidata":"Q6281283","url":"https://en.wikipedia.org/wiki/Joseph_Bailly_Homestead"},{"id":"way/468645924","name":"Lindstrom/Wahl Farm","kind":"historic","lon":-87.09283,"lat":41.62021,"ele_m":null,"wikidata":"Q20711392","url":"https://en.wikipedia.org/wiki/Gust_Lindstrom_Farm"},{"id":"way/254397914","name":"Wieboldt-Rostone House","kind":"historic","lon":-87.00212,"lat":41.68404,"ele_m":null,"wikidata":"Q7998869","url":"https://en.wikipedia.org/wiki/Wieboldt-Rostone_House"},{"id":"node/153688853","name":"Beverly Shores","kind":"place","lon":-86.97753,"lat":41.69254,"ele_m":189.0,"wikidata":"Q2321424","url":"https://en.wikipedia.org/wiki/Beverly_Shores,_Indiana","tour":6,"summary":{"extract":"Beverly Shores is a town in Pine Township, Porter County, Indiana, United States, about 36 miles (58 km) east of downtown Chicago. The population was 597 as of the 2023 5-year ACS census.","url":"https://en.wikipedia.org/wiki/Beverly_Shores%2C_Indiana","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[],"street":null},{"id":"node/153636883","name":"Dune Acres","kind":"place","lon":-87.08587,"lat":41.64948,"ele_m":191.0,"wikidata":"Q2047917","url":"https://en.wikipedia.org/wiki/Dune_Acres,_Indiana","tour":4,"summary":{"extract":"Dune Acres is a town in Westchester Township, Porter County, in the U.S. state of Indiana. The population was 234 as of the 2020 census. Dune Acres is located in the duneland of the south shore of Lake Michigan. Many residents of Dune Acres and surrounding communities helped preserve parts of the Indiana Dunes.","url":"https://en.wikipedia.org/wiki/Dune_Acres%2C_Indiana","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3e/Dune_Acres_Clubhouse.jpg/960px-Dune_Acres_Clubhouse.jpg","page":"https://commons.wikimedia.org/wiki/File:Dune_Acres_Clubhouse.jpg","dist_m":306,"width":640,"height":480,"license":"Public domain","license_url":"","artist":"Nyttend"}],"street":null},{"id":"node/153550650","name":"Ogden Dunes","kind":"place","lon":-87.1917,"lat":41.62281,"ele_m":186.0,"wikidata":"Q2219136","url":"https://en.wikipedia.org/wiki/Ogden_Dunes,_Indiana","tour":1,"summary":{"extract":"Ogden Dunes is a town in Portage Township, Porter County, Indiana, United States. It is located on the shore of Lake Michigan, within Indiana Dunes National Park and nearly surrounded by the city of Portage. The population was 1,168 as of the 2020 census. It is named for multi-millionaire Francis A. Ogden, who owned the land there before his death in 1914. His main interest in the land where the dunes are was the sand which could be scooped up and sold, with more sand being replenished naturally over time.","url":"https://en.wikipedia.org/wiki/Ogden_Dunes%2C_Indiana","licence":"CC BY-SA 4.0","attribution":"Wikipedia"},"photos":[{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8a/Kratz_Field_5482.jpg/960px-Kratz_Field_5482.jpg","page":"https://commons.wikimedia.org/wiki/File:Kratz_Field_5482.jpg","dist_m":126,"width":640,"height":427,"license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","artist":"Chris Light"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/d/da/Kratz_Field_5478.jpg/960px-Kratz_Field_5478.jpg","page":"https://commons.wikimedia.org/wiki/File:Kratz_Field_5478.jpg","dist_m":126,"width":640,"height":427,"license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","artist":"Chris Light"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1f/Ski_Jump_Marker_5480.jpg/960px-Ski_Jump_Marker_5480.jpg","page":"https://commons.wikimedia.org/wiki/File:Ski_Jump_Marker_5480.jpg","dist_m":151,"width":640,"height":427,"license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","artist":"Chris Light"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/6/63/Ski_Jump_location_5481.jpg/960px-Ski_Jump_location_5481.jpg","page":"https://commons.wikimedia.org/wiki/File:Ski_Jump_location_5481.jpg","dist_m":151,"width":640,"height":960,"license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","artist":"Chris Light"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a8/Ski_Jump_5490.jpg/960px-Ski_Jump_5490.jpg","page":"https://commons.wikimedia.org/wiki/File:Ski_Jump_5490.jpg","dist_m":151,"width":640,"height":427,"license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","artist":"Chris Light"},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/Ski_Jump_Marker_5477.jpg/960px-Ski_Jump_Marker_5477.jpg","page":"https://commons.wikimedia.org/wiki/File:Ski_Jump_Marker_5477.jpg","dist_m":151,"width":640,"height":960,"license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","artist":"Chris Light"}],"street":null}],"tour":["way/431452713","node/153550650","way/438733268","way/431490556","node/153636883","way/352635678","node/153688853","node/358680535"],"tour_source":"auto","missing_stops":[]}