# secrets
.env

# virtualenv + python noise
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/

# data: images, DuckDB, model output. Regenerable from the scripts.
data/*
!data/.gitkeep
# ...except the human-entered review verdicts, which are small and irreplaceable.
# (git can't re-include a file under an ignored directory, hence the two-step dance)
!data/review/
data/review/*/*
!data/review/*/review.csv

# macOS
.DS_Store
